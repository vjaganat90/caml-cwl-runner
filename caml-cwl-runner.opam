opam-version: "2.0"
version: "0.1.0"
synopsis: "A CWL v1.2 runner in OCaml"
description:
  "Minimal Common Workflow Language v1.2.1 runner. Slice 1 builds CommandLineTool argv without executing."
maintainer: ["caml-cwl-runner contributors"]
authors: ["caml-cwl-runner contributors"]
license: "Apache-2.0"
homepage: "https://github.com/portmac/caml-cwl-runner"
bug-reports: "https://github.com/portmac/caml-cwl-runner/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.17" & >= "3.17"}
  "cmdliner"
  "yaml"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/portmac/caml-cwl-runner.git"
